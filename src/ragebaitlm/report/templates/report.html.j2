<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ragebaitLM — coding agent rage-meter</title>
  <script type="text/javascript">{{ plotlyjs | safe }}</script>
  <style>
    :root { --bg:#0f1116; --panel:#171a21; --ink:#e8eaed; --muted:#9aa0a6; --accent:#d62728; --joy:#2ca02c; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--ink);
           font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
           line-height:1.5; }
    header { padding:32px 40px 8px; }
    h1 { margin:0 0 4px; font-size:26px; }
    h2 { margin:36px 0 12px; font-size:19px; border-bottom:1px solid #262a33; padding-bottom:6px; }
    h3 { margin:18px 0 8px; font-size:15px; color:var(--muted); font-weight:600; }
    .muted { color:var(--muted); }
    main { padding:0 40px 80px; max-width:1200px; }
    .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-top:20px; }
    .card { background:var(--panel); border:1px solid #262a33; border-radius:10px; padding:16px 18px; }
    .card .label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.05em; }
    .card .value { font-size:26px; font-weight:700; margin-top:6px; }
    .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:start; }
    @media (max-width:900px){ .grid2{grid-template-columns:1fr;} main,header{padding-left:18px;padding-right:18px;} }
    .panel { background:var(--panel); border:1px solid #262a33; border-radius:10px; padding:10px 12px; margin:10px 0; }
    .chart-body { overflow-y:auto; scrollbar-gutter:stable; }
    .resize-handle { height:14px; margin-top:4px; cursor:ns-resize; border-radius:6px;
                     display:flex; align-items:center; justify-content:center; touch-action:none; }
    .resize-handle::before { content:""; width:46px; height:4px; border-radius:2px; background:#3a404d; }
    .resize-handle:hover::before, .resize-handle.dragging::before { background:var(--muted); }
    table { border-collapse:collapse; width:100%; font-size:13px; }
    th,td { text-align:left; padding:7px 10px; border-bottom:1px solid #262a33; }
    th { color:var(--muted); font-weight:600; }
  </style>
</head>
<body>
<header>
  <h1>ragebaitLM</h1>
  <div class="muted">coding agent rage-meter · generated {{ generated_at }}</div>
  <div class="cards">
    <div class="card"><div class="label">user messages</div><div class="value">{{ overall.get('n_messages', 0) }}</div></div>
    <div class="card"><div class="label">sessions</div><div class="value">{{ overall.get('n_sessions', 0) }}</div></div>
    <div class="card"><div class="label">average mood (/100)</div><div class="value">{{ '%+.1f'|format(overall.get('mean_mood', 0)*100) }}</div></div>
    <div class="card"><div class="label">median mood (/100)</div><div class="value">{{ '%+.1f'|format(overall.get('median_mood', 0)*100) }}</div></div>
    <div class="card"><div class="label">% rage (≤ {{ '%.1f'|format(overall.get('rage_threshold', -0.5)*100) }})</div><div class="value" style="color:var(--accent)">{{ '%.1f'|format(overall.get('pct_rage', 0)*100) }}%</div></div>
    <div class="card"><div class="label">% joy (≥ {{ '%.1f'|format(overall.get('joy_threshold', 0.5)*100) }})</div><div class="value" style="color:var(--joy)">{{ '%.1f'|format(overall.get('pct_joy', 0)*100) }}%</div></div>
  </div>
</header>

<main>
  <h2>Summary</h2>
  <div class="grid2">
    <div class="panel">
      <div class="chart-body">{{ charts.by_model | safe }}</div>
      <div class="resize-handle" role="separator" aria-orientation="horizontal" title="Drag to resize"></div>
    </div>
    <div class="panel">
      <div class="chart-body">{{ charts.by_harness | safe }}</div>
      <div class="resize-handle" role="separator" aria-orientation="horizontal" title="Drag to resize"></div>
    </div>
  </div>
  <div class="panel">{{ charts.hist | safe }}</div>

  <h2>Statistics</h2>
  <h3>By preceding model</h3>
  {{ by_model_table | safe }}
  <h3>By harness</h3>
  {{ by_harness_table | safe }}
</main>
<script>
(function () {
  function init(handle) {
    var body = handle.closest('.panel').querySelector('.chart-body');
    var gd = body && body.querySelector('.plotly-graph-div');
    if (!gd) return;
    var wrap = gd.parentElement;
    var startY = 0, startH = 0;

    var h0 = Math.round(gd.getBoundingClientRect().height) || 240;
    if (wrap) wrap.style.height = 'auto';
    gd.style.height = h0 + 'px';
    body.style.height = h0 + 'px';

    function onMove(e) {
      var h = startH + (e.clientY - startY);
      h = Math.max(160, Math.min(4000, h));
      body.style.height = h + 'px';
      var chartH = Math.max(h, h0);
      gd.style.height = chartH + 'px';
      Plotly.relayout(gd, { height: chartH });
      e.preventDefault();
    }
    function onUp() {
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerup', onUp);
      document.removeEventListener('pointercancel', onUp);
      handle.classList.remove('dragging');
      document.body.style.userSelect = '';
    }
    handle.addEventListener('pointerdown', function (e) {
      startY = e.clientY;
      startH = body.getBoundingClientRect().height;
      document.addEventListener('pointermove', onMove);
      document.addEventListener('pointerup', onUp);
      document.addEventListener('pointercancel', onUp);
      handle.classList.add('dragging');
      document.body.style.userSelect = 'none';
      e.preventDefault();
    });
  }
  document.querySelectorAll('.resize-handle').forEach(init);
})();
</script>
</body>
</html>
